<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve arquivos existentes (arquivos e diretórios)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redireciona todas as outras requisições para index.html (SPA fallback)
  RewriteRule ^ index.html [L]
</IfModule>
